<script>
var $=function(i){return document.getElementById(i)};
var DATA=JSON.parse($("data").textContent);
var assets=null,artifact=null;

function fmt(d){var t=new Date(d+"T12:00:00");return isNaN(t)?d:t.toLocaleDateString(undefined,{day:"numeric",month:"long",year:"numeric"})}
function tick(){
  var c=new Date(DATA.closes),ms=c-new Date();
  if(ms<=0){document.body.classList.add("over");return false}
  var d=Math.floor(ms/864e5),h=Math.floor(ms%864e5/36e5),m=Math.floor(ms%36e5/6e4);
  $("left").textContent=(d?d+"d ":"")+h+"h "+m+"m";return true;
}
function el(t,c,txt){var e=document.createElement(t);if(c)e.className=c;if(txt!=null)e.textContent=txt;return e}
function pic(url,alt,cls){
  if(url){var i=el("img",cls);i.src=url;i.alt=alt;return i}
  return el("div",cls+" ph","Your photo goes here");
}
function openLb(url,alt){var s=$("lbslot");s.innerHTML="";s.appendChild(pic(url,alt,"big"));$("lb").classList.add("open");$("x").focus()}

function render(){
  $("ttl").textContent=DATA.title;
  var c=new Date(DATA.closes);
  $("until").textContent=c.toLocaleDateString(undefined,{day:"numeric",month:"long",year:"numeric"});
  var hall=$("hall");hall.innerHTML="";
  DATA.days.slice().sort(function(a,b){return a.date<b.date?-1:1}).forEach(function(day){
    var s=el("section","day"),h=el("div","dayhead");
    h.appendChild(el("h2","",day.title||fmt(day.date)));h.appendChild(el("p","date",fmt(day.date)));s.appendChild(h);
    var ph=day.photos&&day.photos.length?day.photos:["",""];
    var row=el("div","row n"+Math.min(ph.length,3));
    ph.forEach(function(u,i){
      var f=el("div","frame");f.tabIndex=0;f.setAttribute("role","button");f.setAttribute("aria-label","View photo "+(i+1)+" from "+(day.title||fmt(day.date)));
      var m=el("div","mat");m.appendChild(pic(u,day.title||"Photo","pic"));f.appendChild(m);
      var go=function(){openLb(u,day.title||"Photo")};
      f.addEventListener("click",go);
      f.addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();go()}});
      row.appendChild(f);
    });
    s.appendChild(row);
    if(day.msg){var l=el("blockquote","label");l.style.margin="38px auto 0";l.appendChild(el("p","",day.msg));if(day.by)l.appendChild(el("cite","","— "+day.by));s.appendChild(l)}
    hall.appendChild(s);
  });
}

// Viewing
render();if(tick())setInterval(tick,30000);
function closeLb(){$("lb").classList.remove("open")}
$("x").addEventListener("click",closeLb);
$("lb").addEventListener("click",function(e){if(e.target===$("lb"))closeLb()});
document.addEventListener("keydown",function(e){if(e.key==="Escape")closeLb()});

</script>
