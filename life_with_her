<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>A Small Exhibition</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
:root{--wall:#2e3a36;--wall-deep:#1f2825;--ink:#efe9dc;--muted:#a9b3ab;--brass:#c8a65a;--frame:#3b2a1c;--mat:#f3efe6;--light:rgba(255,236,190,.16);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--wall:#232d2a;--wall-deep:#161d1b}}
:root[data-theme="dark"]{--wall:#232d2a;--wall-deep:#161d1b}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*,*::before,*::after{box-sizing:inherit}
[hidden]{display:none!important}
body{margin:0;min-height:100%;background:var(--wall-deep);color:var(--ink);font-family:"Cormorant Garamond",Georgia,serif;font-size:19px;line-height:1.55}
.room{background:linear-gradient(var(--wall),var(--wall-deep));min-height:100vh}
.intro{max-width:640px;margin:0 auto;padding:12vh 24px 8vh;text-align:center}
h1{font-weight:400;font-size:clamp(2.6rem,9vw,4.6rem);line-height:1.02;margin:0 0 .4em}
.intro p{color:var(--muted);margin:0 auto;max-width:34ch}
.closes{margin-top:2.2em;display:inline-block;border:1px solid var(--brass);padding:.7em 1.3em;color:var(--brass)}
.closes b{font-weight:600}
.hall{max-width:1040px;margin:0 auto;padding:0 20px 12vh}
.day{position:relative;margin-bottom:16vh}
.day::before{content:"";position:absolute;top:-6vh;left:50%;width:min(120%,900px);height:60%;transform:translateX(-50%);background:radial-gradient(ellipse at top,var(--light),transparent 68%);pointer-events:none}
.dayhead{position:relative;text-align:center;margin-bottom:34px}
.dayhead h2{font-weight:400;font-size:clamp(1.8rem,5vw,2.6rem);margin:0}
.dayhead .date{color:var(--brass);font-style:italic;margin:.2em 0 0}
.row{position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:30px;align-items:start;margin:0 auto}
.row.n1{max-width:540px}.row.n2{max-width:760px}
.frame{padding:12px;background:var(--frame);border:1px solid #000;box-shadow:0 18px 34px rgba(0,0,0,.45),inset 0 0 0 2px rgba(255,255,255,.08);cursor:zoom-in;border-radius:2px}
.mat{background:var(--mat);padding:clamp(12px,3vw,26px);box-shadow:inset 0 0 8px rgba(0,0,0,.25)}
.pic{display:block;width:100%;height:auto;background:#777}
.ph{aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;text-align:center;color:#5a5446;font-style:italic;padding:1em}
.label{position:relative;max-width:560px;margin:38px auto 0;padding:18px 22px;background:linear-gradient(#d9bd78,#b8964a);color:#2a2112;box-shadow:0 3px 8px rgba(0,0,0,.4);font-size:1.12rem;line-height:1.5}
.label p{margin:0;white-space:pre-wrap}
.label cite{display:block;margin-top:.7em;font-size:.95rem}
footer{text-align:center;color:var(--muted);padding:0 24px 10vh;font-style:italic}
.skirting{height:14px;background:#14191a;border-top:2px solid #0d1110}
.lightbox{position:fixed;inset:0;background:rgba(10,13,12,.94);display:none;align-items:center;justify-content:center;padding:16px;z-index:20}
.lightbox.open{display:flex}
.lightbox .big{max-width:100%;max-height:88vh;box-shadow:0 20px 50px #000}
.lightbox .big.ph{width:min(90vw,480px);background:var(--mat)}
button,input,textarea{font:inherit}
.lightbox button{position:absolute;top:max(14px,env(safe-area-inset-top,0px));right:16px;background:none;border:1px solid var(--muted);color:var(--ink);padding:.3em .9em;cursor:pointer}
button:focus-visible,.frame:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--brass);outline-offset:3px}
.closed{display:none;max-width:520px;margin:0 auto;padding:30vh 24px;text-align:center}
body.over .room,body.over #editBtn,body.over #editor{display:none}body.over .closed{display:block}
#editBtn{position:fixed;right:16px;bottom:max(16px,env(safe-area-inset-bottom,0px));z-index:10;background:var(--brass);color:#2a2112;border:0;padding:.6em 1.1em;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.4)}
#editor{background:#1a211f;border-top:2px solid var(--brass);padding:28px 20px 90px}
#editor .in{max-width:620px;margin:0 auto;display:grid;gap:14px}
#editor h3{margin:0;font-weight:600;font-size:1.5rem}
#editor label{display:grid;gap:4px;color:var(--muted);font-size:.95rem}
#editor input,#editor textarea{background:#0f1413;color:var(--ink);border:1px solid #4b5a54;padding:.5em .7em;border-radius:2px;width:100%}
#editor textarea{min-height:110px;resize:vertical}
.drop{border:2px dashed var(--brass);padding:26px 14px;text-align:center;cursor:pointer;color:var(--muted)}
.drop.over{background:rgba(200,166,90,.12)}
.thumbs{display:flex;flex-wrap:wrap;gap:8px}.thumbs img{width:76px;height:76px;object-fit:cover;border:1px solid #000}
.btn{background:var(--brass);color:#2a2112;border:0;padding:.6em 1.2em;cursor:pointer}
.btn.alt{background:none;color:var(--ink);border:1px solid var(--muted)}
.status{color:var(--brass);min-height:1.4em}
.rm{position:relative;display:block;margin:18px auto 0}
</style>
</head>
<body>
